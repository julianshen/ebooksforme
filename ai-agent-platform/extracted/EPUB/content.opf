    <dc:identifier id="id">manus-agent-platform-2025</dc:identifier>
    <dc:title>建構生產級多 Agent 平台</dc:title>
    <dc:language>zh-TW</dc:language>
    <dc:creator id="creator">Julian Shen</dc:creator>
